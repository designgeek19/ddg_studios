# Security headers for Netlify. This file must stay in the project root (the publish folder).
# Changes take effect on the next deploy. Test at https://securityheaders.com after deploying.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com; connect-src 'self'; frame-src https://cal.com https://app.cal.com https://calendly.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Images can be cached for a day. Raise this once your images stop changing.
/images/*
  Cache-Control: public, max-age=86400

# NOTES FOR LATER
# - If you send forms to Formspree instead of Netlify, add https://formspree.io to connect-src.
# - If you add analytics (for example Plausible), add its script address to script-src and connect-src.
# - If you use a different booking service, add its address to frame-src.
